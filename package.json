{
  "name": "obsidian-daily-games",
  "version": "1.0.0",
  "description": "Obsidian plugin: a grid of your favourite daily games with played-today tracking and streaks.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "install-plugin": "node scripts/install.mjs"
  },
  "devDependencies": {
    "esbuild": "~0.28",
    "eslint": "~10",
    "eslint-plugin-obsidianmd": "~0.5",
    "obsidian": "1.14.4",
    "tslib": "~2.9",
    "typescript": "~7.0",
    "typescript-eslint": "~8.72"
  },
  "license": "MIT",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "daily-games",
    "puzzles"
  ],
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "dependencies": {
    "obsidian-daily-notes-interface": "0.9.5"
  }
}
